def test_vision_inner_replay_uses_state_pool_channels_not_raw_assets() -> None:
    runtime = APV21Runtime()
    image_path = next((Path.cwd() / "legacy_apv2" / "evidence").rglob("*.png"))
    raw = image_path.read_bytes()
    first = runtime.process_multimodal_tick("vision state replay", image_bytes=raw)
    runtime.process_idle_maintenance(include_heavy=True, budget=4, max_ms=50.0)
    second = runtime.process_multimodal_tick("vision state replay", image_bytes=raw)

    assert first["multimodal"]["asset_refs"] == []
    current_frame = first["multimodal"]["inner_vision"]["current_frame"]
    assert current_frame["reconstruction_basis"] == "state_pool_numeric_channels"
    assert current_frame["raw_preview_payload"] is False
    assert "preview_png_b64" not in current_frame
    assert "asset_ref" not in current_frame
    assert "raw_asset_ref" not in current_frame
    vision_obj_rows = [
        row
        for row in first["state_pool"]["snapshot"]["items"]
        if str(row.get("sa_label", "") or "").startswith("vision_obj::")
    ]
    assert vision_obj_rows
    assert all(not ((row.get("anchor_meta", {}) or {}).get("asset_refs", []) or []) for row in vision_obj_rows)
    assert first["multimodal"]["inner_vision"]["object_reconstruction"]
    field_payloads = first["multimodal"]["inner_vision"]["field_reconstruction"]["payloads"]
    assert {"vision.field.color_grid", "vision.field.luma_grid", "vision.field.edge_grid"} <= set(field_payloads)
    object_bundle = first["multimodal"]["inner_vision"]["object_reconstruction"][0]["reconstruction_payload"]
    assert {"vision.object.mask_grid", "vision.object.palette", "vision.object.contour_points", "vision.object.color_layout"} <= set(object_bundle["channels"])
    assert "asset_ref" not in first["multimodal"]["inner_vision"]["object_reconstruction"][0]
    assert runtime.memory.latest_snapshot("state")["asset_refs"] == []
    assert second["fast_system"]["bn"]
    assert all(not row.get("snapshot_preview", {}).get("asset_refs") for row in second["fast_system"]["bn"])


def test_multimodal_runtime_accepts_legacy_audio_bridge_and_emits_inner_audio() -> None:
    runtime = APV21Runtime()
    buf = io.BytesIO()
    with wave.open(buf, "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(16000)
        frames = []
        for idx in range(3200):
            value = int(12000 * math.sin(2 * math.pi * 440 * idx / 16000))
            frames.append(struct.pack("<h", value))
        wav.writeframes(b"".join(frames))
    trace = runtime.process_multimodal_tick("听这个声音", audio_bytes=buf.getvalue())
    assert trace["multimodal"]["inner_audio"]
    snapshot_labels = {str(item.get("sa_label", "") or "") for item in trace["state_pool"]["snapshot"]["items"]}
    assert any(label.startswith("audio") for label in snapshot_labels)


