def test_focus_buffer_tracks_interruption_resumption_and_replay_governance() -> None:
    from memory.short_term.focus_buffer import FocusBuffer

    buffer = FocusBuffer(focus_history_limit=8, episode_break_overlap=0.25, max_replay_items=4)
    buffer.push(
        [{"sa_label": "text::A", "display_text": "A", "family": "text", "query_weight": 1.0, "real_energy": 1.0}],
        tick_index=0,
    )
    buffer.push(
        [{"sa_label": "text::A", "display_text": "A", "family": "text", "query_weight": 1.0, "real_energy": 1.0}],
        tick_index=1,
    )
    buffer.push(
        [{"sa_label": "text::B", "display_text": "B", "family": "text", "query_weight": 1.0, "real_energy": 1.0}],
        tick_index=2,
    )
    buffer.push(
        [{"sa_label": "text::A", "display_text": "A", "family": "text", "query_weight": 1.0, "real_energy": 1.0}],
        tick_index=3,
    )

    trace = buffer.trace(tick_index=3)
    dynamics = trace["continuity_dynamics"]
    assert dynamics["schema_id"] == "focus_continuity_dynamics/v1"
    assert dynamics["recent_interruptions"]
    assert dynamics["recent_resumptions"]
    assert any(event["resumed_episode_id"] == 0 for event in dynamics["recent_resumptions"])

    candidates = trace["replay_candidates"]
    assert candidates
    episode_id = int(candidates[0]["episode_id"])
    buffer.mark_replay_selected(episode_id)
    cooled = next(row for row in buffer.replay_candidates(tick_index=4, limit=4) if int(row["episode_id"]) == episode_id)
    assert "repetition_cooldown" in cooled["governance"]["reasons"]
    assert cooled["governance"]["weight_multiplier"] < 1.0


def test_thought_view_and_observatory_summary_expose_new_contracts() -> None:
    runtime = APV21Runtime()
    trace = runtime.process_text_tick("apple is fruit")
    thought_view = trace["thought_view"]
    assert "fast" in thought_view
    assert "slow" in thought_view
    assert "feelings" in thought_view
    from observatory.trace_view import summarize_tick

    summary = summarize_tick(trace)
    assert "thought_feelings" in summary


def test_observatory_reconstruction_exposes_action_outcome_and_inner_world() -> None:
    from observatory import reconstruct_tick_observatory

    runtime = APV21Runtime()
    for _ in range(3):
        runtime.process_text_tick("alpha beta gamma")
        runtime.process_text_tick("")
    trace = runtime.process_text_tick("alpha beta gamma")
    reconstructed = reconstruct_tick_observatory(
        trace,
        snapshot_lookup=runtime.memory.snapshot_by_id,
        successor_lookup=runtime.memory.successor_links,
    )
    assert reconstructed["action"]["schema_id"] == "apv21_action_observatory/v1"
    assert "outcome_memory" in reconstructed["action"]["drive_state"]
    assert reconstructed["inner_world"]["schema_id"] == "apv21_inner_world_view/v2"
    assert "inner_thought" in reconstructed["inner_world"]
    assert "numeric_channels" in reconstructed["learning"]


def test_observatory_inner_world_layers_are_state_pool_reconstruction_only() -> None:
    from observatory import reconstruct_tick_observatory

    runtime = APV21Runtime()
    image_path = next((Path.cwd() / "legacy_apv2" / "evidence").rglob("*.png"))
    raw = image_path.read_bytes()
    runtime.process_multimodal_tick("vision memory", image_bytes=raw)
    runtime.process_idle_maintenance(include_heavy=True, budget=4, max_ms=50.0)
    trace = runtime.process_multimodal_tick("vision memory", image_bytes=raw)
    reconstructed = reconstruct_tick_observatory(
        trace,
        snapshot_lookup=runtime.memory.snapshot_by_id,
        successor_lookup=runtime.memory.successor_links,
    )
    inner_world = reconstructed["inner_world"]
    vision = inner_world["inner_vision_reconstruction"]
    assert vision["schema_id"] == "inner_vision_reconstruction/v2"
    assert vision["reconstruction_basis"] == "state_pool_numeric_channels"
    assert vision["asset_shortcut_used"] is False
    assert any(layer["layer_type"] == "real" for layer in vision["layers"])
    assert vision["assets"] == []
    assert vision["asset_groups"] == {}
    assert vision["resolver_hints"] == []
    assert vision["objects"]
    assert vision["field"]["payloads"]["vision.field.color_grid"]["payload_values"]
    assert any(row.get("color_layout_payload", {}).get("payload_values") for row in vision["objects"])
    assert all(not row.get("asset_ref") for row in vision["objects"])
    assert all(not row.get("focus_tile_asset_ref") for row in vision["objects"])
    assert vision["recalled_assets"] == []


def test_inner_world_render_model_exports_canvas_and_audio_ready_payload() -> None:
    from observatory import build_inner_world_render_model, reconstruct_tick_observatory, render_inner_world_html

    runtime = APV21Runtime()
    image_path = next((Path.cwd() / "legacy_apv2" / "evidence").rglob("*.png"))
    image_raw = image_path.read_bytes()
    buf = io.BytesIO()
    with wave.open(buf, "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(16000)
        frames = []
        for idx in range(3200):
            value = int(12000 * math.sin(2 * math.pi * 330 * idx / 16000))
            frames.append(struct.pack("<h", value))
        wav.writeframes(b"".join(frames))
    trace = runtime.process_multimodal_tick("render model", image_bytes=image_raw, audio_bytes=buf.getvalue())
    reconstructed = reconstruct_tick_observatory(
        trace,
        snapshot_lookup=runtime.memory.snapshot_by_id,
        successor_lookup=runtime.memory.successor_links,
    )
    model = build_inner_world_render_model(reconstructed)
    assert model["schema_id"] == "apv21_inner_world_render_model/v1"
    assert model["vision_panel"]["objects"]
    assert model["vision_panel"]["reconstruction_source"] == "state_pool_numeric_channels"
    assert model["vision_panel"]["asset_shortcut_used"] is False
    assert model["vision_panel"]["image_sources"] == []
    assert model["audio_panel"]["spectrum_bands"]
    assert model["audio_panel"]["waveform_preview"]
    assert "audio.focus.waveform_slice" in model["audio_panel"]["focus_payload_channels"]
    assert "audio.focus.waveform_slice" in model["audio_panel"]["playback"]["source"]["numeric_channels_used"]
    assert model["audio_panel"]["waveform_source"] == "state_pool_numeric_synthesis"
    assert model["audio_panel"]["spectrum_source"] == "state_pool_numeric_channels"
    assert model["audio_panel"]["audio_sources"] == []
    assert model["audio_panel"]["playback"]["enabled"] is True
    assert model["audio_panel"]["playback"]["source"]["role"] == "state_pool_synthesis"
    assert model["audio_panel"]["playback"]["source"]["asset_id"] == ""
    assert model["audio_panel"]["playback"]["source"]["data_url"].startswith("data:audio/wav;base64,")
    assert model["audio_panel"]["playback"]["decoded_for_preview"] is False
    html = render_inner_world_html(reconstructed)
    assert "<canvas id=\"visionCanvas\"" in html
    assert "apv21_inner_world_render_model/v1" in html


def test_foveated_object_resolution_tracks_visual_focus() -> None:
    from sensors.vision.numeric_sensor import NativeVisionNumericSensor
    from PIL import Image, ImageDraw

    sensor = NativeVisionNumericSensor(max_objects=1)
    image = Image.new("RGB", (96, 72), (235, 238, 240))
    draw = ImageDraw.Draw(image)
    draw.rectangle((35, 20, 61, 52), fill=(230, 90, 60), outline=(30, 40, 55), width=3)
    buf = io.BytesIO()
    image.save(buf, format="PNG")
    raw = buf.getvalue()
    focused = sensor.ingest_image_bytes(
        raw,
        tick_index=0,
        focus_state={"center_x": 0.5, "center_y": 0.5, "scale": 0.55},
    )
    peripheral = sensor.ingest_image_bytes(
        raw,
        tick_index=1,
        focus_state={"center_x": 0.0, "center_y": 0.0, "scale": 0.55},
    )
    focused_obj = focused["inner_vision"]["object_reconstruction"][0]
    peripheral_obj = peripheral["inner_vision"]["object_reconstruction"][0]
    focused_shape = focused_obj["reconstruction_payload"]["channels"]["vision.object.color_layout"]["payload_shape"]
    peripheral_shape = peripheral_obj["reconstruction_payload"]["channels"]["vision.object.color_layout"]["payload_shape"]

    assert focused_obj["sampling_focus"]["precision"] > peripheral_obj["sampling_focus"]["precision"]
    assert focused_shape[0] >= peripheral_shape[0]
    assert focused_shape[1] >= peripheral_shape[1]
    assert focused_obj["variable_resolution"]["policy"] == "continuous_foveated_object_payload_resolution"
    assert peripheral_obj["variable_resolution"]["policy"] == "continuous_foveated_object_payload_resolution"
    assert "vision.object.focus_detail_patch" in focused_obj["reconstruction_payload"]["channels"]
    assert "vision.object.focus_detail_patch" not in peripheral_obj["reconstruction_payload"]["channels"]
    patch_shape = focused_obj["reconstruction_payload"]["channels"]["vision.object.focus_detail_patch"]["payload_shape"]
    assert patch_shape[0] >= focused_shape[0]
    assert patch_shape[1] >= focused_shape[1]
    assert focused_obj["variable_resolution"]["near_original_focus_patch"] is True
    assert peripheral_obj["variable_resolution"]["near_original_focus_patch"] is False


def test_explainability_contract_exposes_fast_bn_focus_and_action_reasons() -> None:
    runtime = APV21Runtime()
    trace = runtime.process_text_tick("apple is fruit")
    explainability = trace["explainability"]
    assert "fast_bn" in explainability
    assert "focus" in explainability
    assert "action" in explainability
    if explainability["fast_bn"]:
        assert "top_score_components" in explainability["fast_bn"][0]


def test_emotion_modulation_is_used_by_attention_and_feedback() -> None:
    runtime = APV21Runtime()
    first = runtime.process_text_tick("alpha beta gamma")
    second = runtime.process_text_tick("")
    third = runtime.process_text_tick("")

    assert first["emotion"]["modulation"]["attention"]
    ranked = second["attention"]["ranked_items"]
    assert ranked
    assert any("emotion_multiplier" in row for row in ranked)
    assert any(float(row.get("emotion_multiplier", 1.0) or 1.0) != 1.0 for row in ranked)

    feedback_deltas = dict((third["emotion"]["update"].get("rwd_pun_deltas", {}) or {}))
    assert feedback_deltas
    assert any(abs(float(value or 0.0)) > 0.0 for value in feedback_deltas.values())
    assert "prior_attention_modulation" in third["explainability"]["emotion"]


def test_state_pool_records_prediction_trace_and_residuals() -> None:
    runtime = APV21Runtime()
    for _ in range(3):
        runtime.process_text_tick("A")
        runtime.process_text_tick("B")

    runtime.process_text_tick("A")
    trace = runtime.process_text_tick("C")

    prediction_trace = trace["state_pool"]["snapshot"]["prediction_trace"]
    assert prediction_trace["schema_id"] == "prediction_energy_trace/v1"
    assert prediction_trace["predicted_labels"] or prediction_trace["actual_labels"]
    assert "missed_predicted_labels" in prediction_trace
    assert "unexpected_labels" in prediction_trace

    residual_summary = trace["state_pool"]["snapshot"]["residual_summary"]
    assert residual_summary["schema_id"] == "state_pool_residual_bucket/v1"
    if prediction_trace["missed_predicted_labels"] or prediction_trace["unexpected_labels"]:
        assert residual_summary["count"] > 0
        assert residual_summary["top"]
        assert residual_summary["top"][0]["last_reason"] in {"prediction_miss", "prediction_unexpected"}

    r_state = trace["state_pool"]["r_state"]
    assert "prediction_trace" in r_state
    assert "residual_summary" in trace["explainability"]["state_pool"]


def test_state_pool_energy_flow_explains_dual_energy_views() -> None:
    runtime = APV21Runtime()
    runtime.state_pool.begin_tick(0)
    runtime.state_pool.apply_predictions(
        [
            {"sa_label": "text::expected", "display_text": "expected", "family": "text", "virtual_energy": 0.9},
            {"sa_label": "text::match", "display_text": "match", "family": "text", "virtual_energy": 0.5},
        ],
        tick_index=0,
        source="test_prediction",
    )
    runtime.state_pool.apply_external_items(
        [
            {"sa_label": "text::actual", "display_text": "actual", "family": "text", "source_type": "external_text", "real_energy": 0.8},
            {"sa_label": "text::match", "display_text": "match", "family": "text", "source_type": "external_text", "real_energy": 0.5},
        ],
        tick_index=0,
    )

    snapshot = runtime.state_pool.snapshot()
    memory_view = runtime.state_pool.snapshot_for_memory_write()
    energy_flow = runtime.state_pool.energy_flow_trace(
        items=snapshot["items"],
        r_state=runtime.state_pool.read_r_state(items_per_head=8, head_limit=4),
        memory_write_items=memory_view["items"],
    )

    assert energy_flow["schema_id"] == "state_pool_energy_flow/v1"
    assert energy_flow["mass"]["positive_pressure"] > 0.0
    assert energy_flow["mass"]["negative_pressure"] > 0.0
    assert energy_flow["prediction_validation"]["missed_count"] >= 1
    assert energy_flow["prediction_validation"]["unexpected_count"] >= 1
    assert energy_flow["residual_semantics"]["interpretation"] in {
        "mixed_mismatch_expected_and_actual_compete",
        "over_prediction_virtual_without_actual",
        "under_prediction_actual_without_virtual",
    }
    assert energy_flow["view_contracts"]["memory_write"]["external_evidence_count"] >= 1
    assert energy_flow["view_contracts"]["r_state"]["has_residual_head"] is True


def test_expectation_pressure_channel_enters_state_pool_and_action_drive() -> None:
    runtime = APV21Runtime()
    for _ in range(3):
        runtime.process_text_tick("A")
        runtime.process_text_tick("B")

    runtime.process_text_tick("A")
    trace = runtime.process_text_tick("C")

    ep = trace["expectation_pressure"]
    assert ep["channels"]
    assert "expectation_level" in ep["channels"]
    assert "pressure_level" in ep["channels"]
    assert ep["items"]

    snapshot_labels = {str(item.get("sa_label", "") or "") for item in trace["state_pool"]["snapshot"]["items"]}
    assert any(label.startswith("expectation_pressure::") for label in snapshot_labels)
    assert "expectation_pressure" in trace["thought_view"]
    assert "expectation_pressure" in trace["explainability"]

    action_notes = [
        note
        for row in trace["action"]["candidates"]
        for note in (row.get("notes", []) or [])
    ]
    assert any(str(note).startswith(("expectation_gap=", "pressure_level=", "expectation_level=")) for note in action_notes)


def test_acceptance_suite_runs_and_reports_known_result_shape() -> None:
    from experiments.acceptance_suite import run_acceptance_suite

    summary = run_acceptance_suite()
    assert summary["schema_id"] == "apv21_acceptance_suite/v1"
    results = {row["experiment"]: row for row in summary["results"]}
    assert {"synonym_bridge", "long_distance_dependency", "yellow_apple", "slip_correction"} <= set(results)
    assert results["synonym_bridge"]["verdict"] in {"pass", "partial", "fail"}
    assert results["long_distance_dependency"]["verdict"] in {"pass", "partial", "fail"}
