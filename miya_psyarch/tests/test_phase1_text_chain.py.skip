def test_action_trace_exposes_candidates_selected_actions_and_feedback_items() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("alpha beta gamma")
    trace = runtime.process_text_tick("")
    action = trace["action"]
    assert action["candidates"]
    assert "drive_state" in action
    snapshot_labels = {str(item.get("sa_label", "") or "") for item in trace["state_pool"]["snapshot"]["items"]}
    if action["selected_actions"]:
        assert action["action_items"]
        assert any(str(item.get("sa_label", "") or "").startswith("action::") for item in action["action_items"])
        assert any(str(item.get("sa_label", "") or "").startswith("action_feedback::") for item in action["feedback_items"])
        assert any(label.startswith("action::") or label.startswith("action_feedback::") for label in snapshot_labels)


def test_action_feedback_updates_future_drive_bias() -> None:
    runtime = APV21Runtime()
    first = runtime.process_text_tick("today weather nice")
    second = runtime.process_text_tick("")
    third = runtime.process_text_tick("")
    first_bias = dict((second["action"].get("drive_state", {}) or {}).get("bias", {}))
    third_bias = dict((third["action"].get("drive_state", {}) or {}).get("bias", {}))
    assert first["action"]["candidates"]
    assert second["action"]["candidates"]
    assert third["action"]["candidates"]
    assert third_bias or third["action"]["selected_actions"]
    if first_bias or third_bias:
        assert first_bias != third_bias or third["action"]["selected_actions"]


def test_action_consequence_trace_uses_successor_feedback_evidence() -> None:
    runtime = APV21Runtime()
    for _ in range(4):
        runtime.process_text_tick("alpha beta gamma")
        runtime.process_text_tick("")

    trace = runtime.process_text_tick("alpha beta gamma")
    consequence = trace["action"]["consequence_trace"]
    assert consequence["schema_id"] == "action_consequence_trace/v1"
    assert "action_estimates" in consequence
    assert consequence["supported_action_count"] >= 1

    candidates = trace["action"]["candidates"]
    assert candidates
    assert any("experience_support" in row["predicted_outcome"] for row in candidates)
    assert any(row.get("consequence_estimate", {}).get("method") == "successor_action_feedback" for row in candidates)
    supported = [row.get("consequence_estimate", {}) for row in candidates if row.get("consequence_estimate", {}).get("support")]
    assert any(int(row.get("outcome_window_count", 0) or 0) >= 1 for row in supported)
    assert "consequence_trace" in trace["explainability"]["action"]


def test_action_consequence_trace_keeps_bounded_multistep_paths() -> None:
    runtime = APV21Runtime()
    for _ in range(5):
        runtime.process_text_tick("start")
        runtime.process_text_tick("middle")
        runtime.process_text_tick("")
        runtime.process_text_tick("")

    trace = runtime.process_text_tick("start")
    consequence = trace["action"]["consequence_trace"]
    policy = consequence["path_policy"]
    assert policy["max_horizon"] >= 2
    assert consequence["successor_context_count"] <= policy["max_successor_rows"]

    estimates = consequence["action_estimates"]
    assert estimates
    max_depth = max(int(row.get("max_depth", 0) or 0) for row in estimates.values())
    assert max_depth >= 2
    assert max_depth <= policy["max_horizon"]


def test_action_feedback_preserves_causal_window_for_future_learning() -> None:
    runtime = APV21Runtime()
    first = runtime.process_text_tick("cause probe")
    second = runtime.process_text_tick("")
    third = runtime.process_text_tick("")

    assert first["action"]["selected_actions"] or second["action"]["selected_actions"]
    feedback = third["action_feedback"]
    if not feedback["applied"]:
        feedback = second["action_feedback"]
    assert feedback["applied"]
    window = feedback["causal_window"]
    assert window["schema_id"] == "action_causal_window/v1"
    assert window["action_ids"]
    assert "before_top_labels" in window
    assert "after_top_labels" in window

    feedback_items = feedback["feedback_items"]
    assert feedback_items
    assert any((item.get("anchor_meta", {}) or {}).get("causal_window", {}).get("schema_id") == "action_causal_window/v1" for item in feedback_items)


def test_action_outcome_memory_shapes_drive_without_concept_teaching() -> None:
    from core.action import ActionConsequencePlanner

    planner = ActionConsequencePlanner(
        enabled=True,
        selection_threshold=0.1,
        max_selected_actions=1,
        fatigue_decay=0.9,
        fatigue_step=0.0,
        bias_learning_rate=0.0,
        bias_gain=0.0,
        confidence_gain=0.18,
        wait_base_drive=0.18,
        outcome_memory_enabled=True,
        outcome_memory_learning_rate=0.22,
        outcome_memory_decay_per_tick=1.0,
        outcome_memory_support_scale=2.0,
        outcome_memory_max_drive_bias=0.75,
    )
    selected = [
        {
            "action_id": "action::inspect_residual",
            "actuator_id": "actuator::attention",
            "predicted_outcome": {
                "reward": 0.12,
                "punishment": 0.08,
                "correctness": 0.1,
                "pressure": 0.05,
                "confidence": 0.5,
            },
        }
    ]
    for idx in range(6):
        planner.plan(
            tick_index=idx,
            state_snapshot_items=[],
            fast_bn=[],
            fast_cn=[],
            slow_bn=[],
            slow_cn=[],
            cognitive_feelings={"channels": {}},
            rhythm_trace={"channels": {}},
            time_trace={"channels": {}},
        )
        feedback = planner.record_feedback(
            selected_actions=selected,
            observed_feedback={"reward": 0.0, "punishment": 0.62, "correctness": 0.0, "confidence": 0.88},
        )
    memory = feedback["outcome_memory"]
    estimate = next(row for row in memory["estimates"] if row["action_id"] == "action::inspect_residual")
    assert estimate["failure_count"] >= 6
    assert estimate["avoidance_bias"] > estimate["approach_bias"]
    assert estimate["drive_bias"] < 0.0

    trace = planner.plan(
        tick_index=7,
        state_snapshot_items=[],
        fast_bn=[],
        fast_cn=[],
        slow_bn=[],
        slow_cn=[],
        cognitive_feelings={"channels": {"dissonance": 1.0, "pressure": 1.0}},
        rhythm_trace={"channels": {}},
        time_trace={"channels": {}},
    )
    candidate = next(row for row in trace["candidates"] if row["action_id"] == "action::inspect_residual")
    assert candidate["outcome_memory_estimate"]["support"] > 0.0
    assert candidate["outcome_drive_bias"] < 0.0
    assert "outcome_memory_support" in candidate["predicted_outcome"]


def test_action_feedback_item_encodes_punishment_as_virtual_drive_shaping() -> None:
    runtime = APV21Runtime()
    selected = [
        {
            "action_id": "action::inspect_residual",
            "predicted_outcome": {"reward": 0.0, "punishment": 0.2, "correctness": 0.0, "pressure": 0.2},
            "consequence_estimate": {},
        }
    ]
    planner_feedback = {
        "outcome_memory": {
            "estimates": [
                {
                    "action_id": "action::inspect_residual",
                    "support": 0.5,
                    "drive_bias": -0.2,
                }
            ]
        }
    }
    items = runtime._build_action_feedback_items(
        selected_actions=selected,
        observed_feedback={"reward": 0.0, "punishment": 0.8, "correctness": 0.0, "confidence": 0.9},
        planner_feedback=planner_feedback,
        causal_window={"schema_id": "action_causal_window/v1", "action_ids": ["action::inspect_residual"]},
    )
    item = items[0]
    assert item["real_energy"] == 0.0
    assert item["virtual_energy"] > 0.0
    meta = item["anchor_meta"]
    assert meta["outcome_memory_estimate"]["drive_bias"] < 0.0
    assert meta["feedback_energy_semantics"]["meaning"].startswith("reward_correctness_as_real")


