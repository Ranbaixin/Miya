from miya_psyarch.core.runtime.engine import APV21Runtime


def test_dual_energy_fields_exist_in_state_pool() -> None:
    runtime = APV21Runtime()
    trace = runtime.process_text_tick("今天下雨")
    snapshot = trace["state_pool"]["snapshot"]["items"]
    assert snapshot
    row = snapshot[0]
    assert "real_energy" in row
    assert "virtual_energy" in row
    assert "cognitive_pressure" in row


def test_performance_profiles_scale_recall_accuracy_budget() -> None:
    from config.performance_profiles import runtime_config_for_profile

    low = runtime_config_for_profile("conservative", target_tick_ms=60)
    balanced = runtime_config_for_profile("balanced", target_tick_ms=100)
    high = runtime_config_for_profile("high_accuracy", target_tick_ms=150)

    assert low.memory.core_item_limit < balanced.memory.core_item_limit < high.memory.core_item_limit
    assert low.memory.candidate_limit < balanced.memory.candidate_limit < high.memory.candidate_limit
    assert low.state_pool.memory_snapshot_limit < balanced.state_pool.memory_snapshot_limit < high.state_pool.memory_snapshot_limit
    assert low.state_pool.r_state_items_per_head < balanced.state_pool.r_state_items_per_head < high.state_pool.r_state_items_per_head
    assert balanced.state_pool.r_state_head_limit * balanced.state_pool.r_state_items_per_head >= 512
    assert balanced.memory.query_feature_limit >= 1024
    assert high.state_pool.r_state_head_limit * high.state_pool.r_state_items_per_head >= 2048
    assert high.text_sensor.budget_limit >= 1024


def test_fast_and_slow_system_paths_both_exist() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("今天下雨 我想带伞")
    trace = runtime.process_text_tick("今天下雨 我想带伞")
    assert "bn" in trace["fast_system"]
    assert "cn" in trace["fast_system"]
    assert "bn_prime" in trace["slow_system"]
    assert "cn_prime" in trace["slow_system"]


def test_empty_tick_keeps_a_live_query_path_after_text_history() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("今天下雨 我想带伞")
    runtime.process_text_tick("今天下雨 我想带伞")
    trace = runtime.process_text_tick("")
    assert trace["state_pool"]["query_view"]
    assert trace["attention"]["selected_labels"]


def test_memory_bootstrap_can_seed_empty_tick_after_cold_runtime() -> None:
    trainer = APV21Runtime()
    trainer.process_text_tick("苹果 是 水果")
    trainer.process_text_tick("苹果 是 水果")
    latest_state = trainer.memory.latest_snapshot("state")
    latest_focus = trainer.memory.latest_snapshot("focus")
    assert latest_state is not None
    assert latest_focus is not None

    cold = APV21Runtime()
    cold.memory._snapshots = list(trainer.memory._snapshots)
    cold.memory._recent_by_kind = {key: list(value) for key, value in trainer.memory._recent_by_kind.items()}
    cold.memory._next_id = trainer.memory._next_id

    trace = cold.process_text_tick("", memory_bootstrap=True)
    snapshot = trace["state_pool"]["snapshot"]["items"]
    assert snapshot
    assert any(float(item["virtual_energy"]) > 0.0 for item in snapshot)


def test_bn_recall_contains_white_box_candidate_sources() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("apple is fruit")
    trace = runtime.process_text_tick("apple is fruit")
    bn = trace["fast_system"]["bn"]
    assert bn
    assert any(row.get("candidate_sources") for row in bn)
    assert all("score_breakdown" in row for row in bn)
    assert all("energy_overlap" in row["score_breakdown"] for row in bn)


def test_memory_recall_keeps_state_and_focus_vector_indexes_separate() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("state only alpha")
    runtime.process_text_tick("")

    state_snapshot = runtime.memory.latest_snapshot("state")
    focus_snapshot = runtime.memory.latest_snapshot("focus")
    assert state_snapshot is not None
    assert focus_snapshot is not None

    state_rows = runtime.memory.recall(state_snapshot["items"], memory_kind="state", top_k=5)
    focus_rows = runtime.memory.recall(focus_snapshot["items"], memory_kind="focus", top_k=5)
    assert state_rows
    assert focus_rows
    assert all(row["memory_kind"] == "state" for row in state_rows)
    assert all(row["memory_kind"] == "focus" for row in focus_rows)

    ann_summary = runtime.memory.ann_summary()
    assert "state" in ann_summary
    assert "focus" in ann_summary


def test_fast_r_state_default_budget_supports_1024_level_query_body() -> None:
    from config.defaults import RuntimeConfig, TextSensorConfig

    config = RuntimeConfig(text_sensor=TextSensorConfig(budget_limit=1200, competition_limit=1200))
    runtime = APV21Runtime(config=config)
    text = " ".join(f"wide{i}" for i in range(1100))
    trace = runtime.process_text_tick(text)
    r_state = trace["state_pool"]["r_state"]
    query = trace["state_pool"]["query_view"]
    assert r_state["total_pool_size"] >= 1024
    head_total = r_state.get("total_head_item_count", sum(len(head.get("items", []) or []) for head in r_state.get("heads", []) or []))
    assert head_total >= 1024
    assert trace["state_pool"].get("query_view_total_count", len(query)) >= 1024

    debug_trace = runtime.process_text_tick(text, trace_mode="debug")
    assert len(debug_trace["state_pool"]["query_view"]) >= 1024


def test_summary_trace_keeps_1024_query_as_refs_not_full_rows() -> None:
    from config.performance_profiles import runtime_config_for_profile

    runtime = APV21Runtime(config=runtime_config_for_profile("balanced", target_tick_ms=100))
    text = " ".join(f"wide{i}" for i in range(1100))
    trace = runtime.process_text_tick(text)

    assert trace["trace_mode"] == "summary"
    assert trace["state_pool"]["query_view_total_count"] >= 1024
    assert len(trace["state_pool"]["query_view"]) < 128
    assert trace["input"]["sa_item_count"] >= 1024
    assert len(trace["input"]["sa_items"]) < 128
    assert trace["thought_view"]["mode"] == "runtime_refs"
    assert trace["explainability"]["mode"] == "runtime_refs"

    debug_trace = runtime.process_text_tick(text, trace_mode="debug")
    assert debug_trace["trace_mode"] == "debug"
    assert len(debug_trace["state_pool"]["query_view"]) >= 1024


def test_cn_successor_uses_transition_store_predictions() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("today weather nice")
    runtime.process_text_tick("i want go_out")
    trace = runtime.process_text_tick("today weather nice")
    cn = trace["fast_system"]["cn"]
    predicted_labels = [item.get("sa_label") for branch in cn for item in branch.get("predicted_items", [])]
    assert predicted_labels
    assert any(str(label).startswith("text::") or str(label).startswith("phrase::") for label in predicted_labels)


