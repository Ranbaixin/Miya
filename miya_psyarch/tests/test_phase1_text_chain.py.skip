    for _ in range(4):
        runtime.process_multimodal_tick("苹果", image_bytes=raw)
        runtime.process_idle_maintenance(include_heavy=True, budget=4, max_ms=50.0)

    trace = runtime.process_multimodal_tick("苹果", image_bytes=raw)
    learning = trace["learning"]["online_embedding"]
    multimodal = learning["multimodal_learning"]
    assert multimodal["schema_id"] == "multimodal_handle_learning/v1"
    assert multimodal["total_events"] > 0
