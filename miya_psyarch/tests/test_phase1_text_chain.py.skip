def test_numeric_feature_channels_can_recall_without_label_overlap() -> None:
    from memory.store import MemoryStore

    memory = MemoryStore(
        recall_top_k=3,
        predict_top_k=2,
        prediction_energy_scale=0.5,
        max_snapshots_per_kind=16,
        candidate_limit=8,
        scoring_candidate_limit=8,
        numeric_enabled=True,
        numeric_weight=2.0,
    )
    historical_items = [
        {
            "sa_label": "vision_obj::apple_old",
            "display_text": "old apple",
            "source_type": "vision_numeric",
            "family": "vision_object",
            "real_energy": 1.0,
            "numeric_features": {
                "vision.shape": [0.9, 0.1, 0.2, 0.0],
                "vision.color": [0.95, 0.85, 0.12],
            },
        }
    ]
    memory.write_snapshot(tick_index=0, memory_kind="state", items=historical_items, focus_labels=[], source_text="")
    memory.process_idle_index_maintenance(budget=4, max_ms=50.0)

    query_items = [
        {
            "sa_label": "vision_obj::query_yellow_round",
            "display_text": "query object",
            "source_type": "vision_numeric",
            "family": "vision_object",
            "real_energy": 1.0,
            "numeric_features": {
                "vision.shape": [0.88, 0.12, 0.2, 0.0],
                "vision.color": [0.93, 0.82, 0.1],
            },
        }
    ]
    rows = memory.recall(query_items, memory_kind="state", top_k=3)
    assert rows
    assert rows[0]["memory_id"] == "mem-1"
    assert rows[0]["label_overlap"] == 0
    assert rows[0]["score_breakdown"]["numeric_score"] > 0.0
    assert rows[0]["numeric_score_breakdown"]["vision.shape"] > 0.9
    assert any(str(source).startswith("numeric:") or str(source).startswith("numeric_rerank:") for source in rows[0]["candidate_sources"])


