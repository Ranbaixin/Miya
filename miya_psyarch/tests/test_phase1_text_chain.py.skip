def test_audio_inner_playback_uses_state_pool_synthesis_not_raw_assets() -> None:
    runtime = APV21Runtime()
    buf = io.BytesIO()
    with wave.open(buf, "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(16000)
        frames = []
        for idx in range(3200):
            value = int(12000 * math.sin(2 * math.pi * 440 * idx / 16000))
            frames.append(struct.pack("<h", value))
        wav.writeframes(b"".join(frames))
    trace = runtime.process_multimodal_tick("audio state playback", audio_bytes=buf.getvalue())
    assert trace["multimodal"]["asset_refs"] == []
    preview = trace["multimodal"]["inner_audio"]["preview_asset_ref"]
    assert preview["reconstruction_basis"] == "state_pool_numeric_channels"
    assert preview["raw_preview_payload"] is False
    assert "preview_wav_b64" not in preview
    assert "asset_ref" not in preview
    assert "focus_window_asset_ref" not in preview
    assert "feature_asset_ref" not in preview
    audio_rows = [
        row
        for row in trace["state_pool"]["snapshot"]["items"]
        if str(row.get("source_type", "")) == "audio_numeric"
    ]
    assert audio_rows
    event_row = next(row for row in audio_rows if str(row.get("sa_label", "")) == "audio_event::current")
    bundle = event_row["reconstruction_payload"]
    assert bundle["schema_id"] == "reconstruction_payload_bundle/v1"
    assert "audio.focus.waveform_slice" in bundle["channels"]
    assert all(not ((row.get("anchor_meta", {}) or {}).get("asset_refs", []) or []) for row in audio_rows)
    assert runtime.memory.latest_snapshot("state")["asset_refs"] == []


def test_multimodal_handle_learning_records_events_and_contributions() -> None:
    runtime = APV21Runtime()
