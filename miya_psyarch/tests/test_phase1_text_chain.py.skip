def test_focus_memory_preserves_order_features_for_slow_recall() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("red blue green")
    runtime.process_text_tick("")
    focus_snapshot = runtime.memory.latest_snapshot("focus")
    assert focus_snapshot is not None
    sequence = focus_snapshot.get("sequence_features", {})
    assert sequence.get("focus_order")
    assert isinstance(sequence.get("sequence_bigrams", []), list)
    if len(sequence["focus_order"]) >= 2:
        assert any(str(token).startswith("focus_seq::") for token in sequence.get("sequence_bigrams", []))


def test_focus_order_stabilizes_external_text_without_changing_attention_winners() -> None:
    runtime = APV21Runtime()
    selected = [
        {"sa_label": "text::gamma", "display_text": "gamma", "source_type": "external_text", "family": "text", "position": 2, "focus_score": 4.0},
        {"sa_label": "feeling::surprise", "display_text": "surprise", "source_type": "cognitive_feeling", "family": "cognitive_feeling", "focus_score": 3.0},
        {"sa_label": "text::alpha", "display_text": "alpha", "source_type": "external_text", "family": "text", "position": 0, "focus_score": 2.0},
        {"sa_label": "text::beta", "display_text": "beta", "source_type": "external_text", "family": "text", "position": 1, "focus_score": 1.0},
    ]

    ordered, trace = runtime._stabilize_focus_order(selected)
    labels = [item["sa_label"] for item in ordered]
    assert labels == ["text::alpha", "feeling::surprise", "text::beta", "text::gamma"]
    assert trace["raw_attention_labels"] == ["text::gamma", "feeling::surprise", "text::alpha", "text::beta"]
    assert trace["ordered_focus_labels"] == labels
    assert trace["changed"] is True
    assert [item["sa_label"] for item in ordered if item["sa_label"].startswith("feeling::")] == ["feeling::surprise"]


def test_focus_family_budget_keeps_focus_memory_from_single_family_monopoly() -> None:
    from config.defaults import AttentionConfig, RuntimeConfig

    runtime = APV21Runtime(
        config=RuntimeConfig(
            attention=AttentionConfig(
                focus_limit=6,
                focus_family_action_max=2,
                focus_family_cognitive_feeling_max=2,
                focus_family_text_max=4,
            )
        )
    )
    ranked = [
        {"sa_label": "action::a1", "display_text": "a1", "family": "action", "source_type": "action", "focus_score": 9.0},
        {"sa_label": "action::a2", "display_text": "a2", "family": "action", "source_type": "action", "focus_score": 8.0},
        {"sa_label": "action::a3", "display_text": "a3", "family": "action", "source_type": "action", "focus_score": 7.0},
        {"sa_label": "feeling::surprise", "display_text": "surprise", "family": "cognitive_feeling", "source_type": "cognitive_feeling", "focus_score": 6.0},
        {"sa_label": "feeling::pressure", "display_text": "pressure", "family": "cognitive_feeling", "source_type": "cognitive_feeling", "focus_score": 5.0},
        {"sa_label": "feeling::dissonance", "display_text": "dissonance", "family": "cognitive_feeling", "source_type": "cognitive_feeling", "focus_score": 4.0},
        {"sa_label": "text::alpha", "display_text": "alpha", "family": "text", "source_type": "external_text", "focus_score": 3.0},
        {"sa_label": "text::beta", "display_text": "beta", "family": "text", "source_type": "external_text", "focus_score": 2.0},
    ]

    selected, trace = runtime._shape_focus_family_budget(ranked_items=ranked, raw_selected_items=ranked[:6])
    labels = [item["sa_label"] for item in selected]

    assert labels == ["action::a1", "action::a2", "feeling::surprise", "feeling::pressure", "text::alpha", "text::beta"]
    assert trace["raw_selected_labels"] == [
        "action::a1",
        "action::a2",
        "action::a3",
        "feeling::surprise",
        "feeling::pressure",
        "feeling::dissonance",
    ]
    assert trace["family_counts"]["action"] == 2
    assert trace["family_counts"]["cognitive_feeling"] == 2
    assert trace["family_counts"]["text"] == 2
    assert trace["changed"] is True
    assert trace["overflow_count"] >= 2
    assert all(item["focus_family_bucket"] in {"action", "cognitive_feeling", "text"} for item in selected)


def test_focus_family_budget_relaxes_caps_only_when_window_would_underfill() -> None:
    from config.defaults import AttentionConfig, RuntimeConfig

    runtime = APV21Runtime(config=RuntimeConfig(attention=AttentionConfig(focus_limit=4, focus_family_action_max=1)))
    ranked = [
        {"sa_label": "action::a1", "family": "action", "source_type": "action", "focus_score": 4.0},
        {"sa_label": "action::a2", "family": "action", "source_type": "action", "focus_score": 3.0},
    ]

    selected, trace = runtime._shape_focus_family_budget(ranked_items=ranked, raw_selected_items=ranked)

    assert [item["sa_label"] for item in selected] == ["action::a1", "action::a2"]
    assert trace["family_counts"]["action"] == 2
    assert trace["relaxed_fill_count"] == 1


def test_build_slow_query_preserves_current_focus_order_before_weight_sort() -> None:
    runtime = APV21Runtime()
    runtime.state_pool.begin_tick(0)
    runtime.state_pool.apply_external_items(
        [
            {"sa_label": "text::alpha", "display_text": "alpha", "source_type": "external_text", "family": "text", "position": 0, "real_energy": 0.4},
            {"sa_label": "text::beta", "display_text": "beta", "source_type": "external_text", "family": "text", "position": 1, "real_energy": 2.0},
            {"sa_label": "text::gamma", "display_text": "gamma", "source_type": "external_text", "family": "text", "position": 2, "real_energy": 1.0},
        ],
        tick_index=0,
    )
    selected = [
        {"sa_label": "text::alpha"},
        {"sa_label": "text::beta"},
        {"sa_label": "text::gamma"},
    ]

    slow_query = runtime._build_slow_query(selected)
    labels = [item["sa_label"] for item in slow_query[:3]]
    assert labels == ["text::alpha", "text::beta", "text::gamma"]
    assert [item.get("focus_order_index") for item in slow_query[:3]] == [0, 1, 2]


def test_sequence_features_are_posting_recall_sources() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("alpha beta gamma")
    runtime.process_text_tick("")
    focus_snapshot = runtime.memory.latest_snapshot("focus")
    assert focus_snapshot is not None
    rows = runtime.memory.recall(focus_snapshot["items"], memory_kind="focus", top_k=5)
    assert rows
    assert any("posting:sequence" in (row.get("candidate_sources", []) or []) for row in rows)
    assert any((row.get("matched_tokens", {}) or {}).get("sequence") for row in rows)


def test_relative_relation_score_distinguishes_same_tokens_different_order() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("me bite dog")
    runtime.process_text_tick("dog bite me")

    query_items = [
        {
            "sa_label": "text::me",
            "display_text": "me",
            "source_type": "external_text",
            "family": "text",
            "position": 0,
            "real_energy": 1.0,
        },
        {
            "sa_label": "text::bite",
            "display_text": "bite",
            "source_type": "external_text",
            "family": "text",
            "position": 1,
            "real_energy": 1.0,
        },
        {
            "sa_label": "text::dog",
            "display_text": "dog",
            "source_type": "external_text",
            "family": "text",
            "position": 2,
            "real_energy": 1.0,
        },
    ]

    rows = runtime.memory.recall(query_items, memory_kind="state", top_k=5)
    assert rows
    by_source = {row["source_text"]: row for row in rows}
    assert "me bite dog" in by_source
    assert "dog bite me" in by_source
    same_order = by_source["me bite dog"]
    reverse_order = by_source["dog bite me"]
    assert same_order["relative_relation_score"] > reverse_order["relative_relation_score"]
    assert same_order["score"] > reverse_order["score"]
    assert same_order["score_breakdown"]["relative_relation_score"] > 0.0
    assert "text_order" in same_order["score_breakdown"]["relation_channels"]


def test_bn_rows_expose_normalized_weight_match_efficiency_and_energy() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("apple fruit sweet")
    trace = runtime.process_text_tick("apple fruit sweet")

    bn = trace["fast_system"]["bn"]
    assert bn
    weight_sum = sum(float(row.get("normalized_weight", 0.0) or 0.0) for row in bn)
    assert 0.98 <= weight_sum <= 1.02
    assert all("match_efficiency" in row for row in bn)
    assert all("grasp_confidence" in row for row in bn)
    assert all("b_real_energy" in row for row in bn)
    assert bn[0]["match_efficiency"] > 0.5
    assert bn[0]["grasp_confidence"] == bn[0]["match_efficiency"]
    assert bn[0]["b_real_energy"] > 0.0
    assert bn[0]["score_breakdown"]["normalized_weight"] == bn[0]["normalized_weight"]


def test_relation_weight_affects_b_energy_for_same_tokens_different_order() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("me bite dog")
    runtime.process_text_tick("dog bite me")

    query_items = [
        {"sa_label": "text::me", "display_text": "me", "source_type": "external_text", "family": "text", "position": 0, "real_energy": 1.0},
        {"sa_label": "text::bite", "display_text": "bite", "source_type": "external_text", "family": "text", "position": 1, "real_energy": 1.0},
        {"sa_label": "text::dog", "display_text": "dog", "source_type": "external_text", "family": "text", "position": 2, "real_energy": 1.0},
    ]
    rows = runtime.memory.recall(query_items, memory_kind="state", top_k=5)
    by_source = {row["source_text"]: row for row in rows}
    same_order = by_source["me bite dog"]
    reverse_order = by_source["dog bite me"]

    assert same_order["relative_relation_score"] > reverse_order["relative_relation_score"]
    assert same_order["normalized_weight"] > reverse_order["normalized_weight"]
    assert same_order["b_real_energy"] > reverse_order["b_real_energy"]
    assert same_order["energy_transfer"]["policy"] == "query_mass_times_normalized_score_times_nonlinear_grasp"


def test_cn_virtual_energy_scales_with_source_b_weight() -> None:
    from memory.store import MemoryStore

    memory = MemoryStore(
        recall_top_k=5,
        predict_top_k=5,
        prediction_energy_scale=0.5,
        max_snapshots_per_kind=16,
        candidate_limit=16,
        scoring_candidate_limit=16,
        online_enabled=False,
    )

    def text_items(text: str) -> list[dict]:
        return [
            {"sa_label": f"text::{unit}", "display_text": unit, "source_type": "external_text", "family": "text", "position": idx, "real_energy": 1.0}
            for idx, unit in enumerate(text.split())
        ]

    memory.write_snapshot(tick_index=0, memory_kind="state", items=text_items("me bite dog"), focus_labels=[], source_text="me bite dog")
    memory.write_snapshot(tick_index=1, memory_kind="state", items=text_items("pain"), focus_labels=[], source_text="pain")
    memory.write_snapshot(tick_index=2, memory_kind="state", items=text_items("dog bite me"), focus_labels=[], source_text="dog bite me")
    memory.write_snapshot(tick_index=3, memory_kind="state", items=text_items("fear"), focus_labels=[], source_text="fear")

    bn = memory.recall(text_items("me bite dog"), memory_kind="state", top_k=5)
    source_map = {row["source_text"]: row for row in bn}
    same_b = source_map["me bite dog"]
    reverse_b = source_map["dog bite me"]
    same_best = memory.successors(same_b["memory_id"], memory_kind="state", source_b_row=same_b)[0]
    reverse_best = memory.successors(reverse_b["memory_id"], memory_kind="state", source_b_row=reverse_b)[0]
    same_energy = sum(float(item.get("virtual_energy", 0.0) or 0.0) for item in same_best.get("predicted_items", []))
    reverse_energy = sum(float(item.get("virtual_energy", 0.0) or 0.0) for item in reverse_best.get("predicted_items", []))

    assert same_b["relative_relation_score"] > reverse_b["relative_relation_score"]
    assert same_best["source_b_weight"] > reverse_best["source_b_weight"]
    assert same_best["energy_transfer_multiplier"] > reverse_best["energy_transfer_multiplier"]
    assert same_energy > reverse_energy
    assert all("base_virtual_energy" in item for item in same_best.get("predicted_items", []))


def test_grasp_uses_bn_match_efficiency_contract() -> None:
    from channels.cognitive_feelings.channel import CognitiveFeelingChannel

    channel = CognitiveFeelingChannel(
        min_activation=0.0,
        surprise_gain=1.0,
        coherence_gain=1.0,
        dissonance_gain=1.0,
        correctness_gain=1.0,
        grasp_gain=1.0,
        expectation_gain=1.0,
        pressure_gain=1.0,
    )
    trace = channel.derive(
        state_snapshot_items=[{"sa_label": "text::probe", "real_energy": 1.0, "virtual_energy": 0.8}],
        fast_bn=[{"score": 0.1, "normalized_weight": 1.0, "match_efficiency": 0.86, "grasp_confidence": 0.86}],
        fast_cn=[],
        slow_bn=[],
        slow_cn=[],
    )
    assert trace["channels"]["grasp"] > 0.25
    grasp_item = next(item for item in trace["items"] if item["sa_label"] == "feeling::grasp")
    derived = grasp_item["anchor_meta"]["derived_from"]
    assert derived["fast_grasp"] == 0.86


def test_prediction_alignment_lowers_surprise_dissonance_and_raises_coherence_correctness() -> None:
    from channels.cognitive_feelings.channel import CognitiveFeelingChannel

    channel = CognitiveFeelingChannel(
        min_activation=0.0,
        surprise_gain=1.0,
        coherence_gain=1.0,
        dissonance_gain=1.0,
        correctness_gain=1.0,
        grasp_gain=1.0,
        expectation_gain=1.0,
        pressure_gain=1.0,
    )
    bad = channel.derive(
        state_snapshot_items=[{"sa_label": "text::x", "real_energy": 1.0, "virtual_energy": 2.4}],
        fast_bn=[{"score": 0.2, "normalized_weight": 1.0, "match_efficiency": 0.2}],
        fast_cn=[{"predicted_items": [{"sa_label": "text::wrong", "virtual_energy": 1.0}]}],
        slow_bn=[],
        slow_cn=[],
        prediction_trace={"alignment_score": 0.0, "mismatch_ratio": 0.9, "unexpected_count": 2, "missed_count": 2},
        residual_summary={"total_unresolved_mass": 2.0},
    )
    good = channel.derive(
        state_snapshot_items=[{"sa_label": "text::x", "real_energy": 1.0, "virtual_energy": 0.9}],
        fast_bn=[{"score": 2.7, "normalized_weight": 1.0, "match_efficiency": 0.92, "grasp_confidence": 0.92}],
        fast_cn=[{"predicted_items": [{"sa_label": "text::x", "virtual_energy": 0.9}]}],
        slow_bn=[{"score": 2.4, "normalized_weight": 1.0, "match_efficiency": 0.86, "grasp_confidence": 0.86}],
        slow_cn=[],
        prediction_trace={"alignment_score": 0.95, "mismatch_ratio": 0.0, "unexpected_count": 0, "missed_count": 0},
        residual_summary={"total_unresolved_mass": 0.0},
    )
    assert good["channels"]["surprise"] < bad["channels"]["surprise"]
    assert good["channels"]["dissonance"] < bad["channels"]["dissonance"]
    assert good["channels"]["coherence"] > bad["channels"]["coherence"]
    assert good["channels"]["correctness"] > bad["channels"]["correctness"]
    assert any(item["sa_label"] == "feeling::coherence" for item in good["items"])
    assert any(item["sa_label"] == "feeling::correctness" for item in good["items"])


def test_relative_relation_learning_summary_is_bounded_and_white_boxed() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("alpha beta gamma")
    runtime.process_text_tick("alpha beta gamma")
    online = runtime.memory.online_embedding_summary()
    summary = online["relative_relations"]
    assert summary["schema_id"] == "relative_relation_store/v1"
    assert summary["snapshot_count"] >= 1
    assert summary["total_events"] >= 1
    assert summary["policy"]["update_semantics"] == "typed_relation_view;shared_evidence_not_shared_score"
    layered = online["layered_online_learning"]
    assert layered["policy"]["local_only"] is True
    assert layered["policy"]["online_update"] is True
    assert layered["policy"]["black_box_replacement"] is False
    layer_names = {row["name"] for row in layered["layers"]}
    assert "content_recognition_embedding" in layer_names
    assert "relation_order_embedding" in layer_names
    assert "multimodal_binding_embedding" in layer_names


def test_state_memory_write_can_store_large_sa_distribution() -> None:
    from config.defaults import RuntimeConfig, StatePoolConfig, TextSensorConfig

    config = RuntimeConfig(
        text_sensor=TextSensorConfig(budget_limit=1400, competition_limit=1400),
        state_pool=StatePoolConfig(snapshot_limit=24, memory_snapshot_limit=1200),
    )
    runtime = APV21Runtime(config=config)
    text = " ".join(f"tok{i}" for i in range(1100))
    runtime.process_text_tick(text)
    state_snapshot = runtime.memory.latest_snapshot("state")
    assert state_snapshot is not None
    assert len(state_snapshot["items"]) >= 1024
    assert len(state_snapshot["core_items"]) >= 1024
    assert len(runtime.state_pool.snapshot()["items"]) <= 24


def test_idle_maintenance_processes_heavy_state_index_jobs_outside_tick() -> None:
    from config.performance_profiles import runtime_config_for_profile

    runtime = APV21Runtime(config=runtime_config_for_profile("balanced", target_tick_ms=100))
    text = " ".join(f"tok{i}" for i in range(1100))
    runtime.process_text_tick(text)
    pending = runtime.memory.pending_index_job_summary()
    assert pending["heavy"] >= 1

    trace = runtime.process_idle_maintenance(include_heavy=True, budget=1, max_ms=50.0)
    assert trace["policy"] == "idle_heavy_index_maintenance"
    assert trace["processed"] >= 1
    assert runtime.memory.pending_index_job_summary()["heavy"] < pending["heavy"]


def test_observatory_can_reconstruct_full_memory_detail_from_summary_refs() -> None:
    from config.performance_profiles import runtime_config_for_profile
    from observatory import reconstruct_bn_row_detail, reconstruct_memory_detail, reconstruct_tick_observatory

    runtime = APV21Runtime(config=runtime_config_for_profile("balanced", target_tick_ms=100))
    text = " ".join(f"tok{i}" for i in range(1100))
    runtime.process_text_tick(text)
    trace = runtime.process_text_tick(text)
    state_snapshot = runtime.memory.latest_snapshot("state")
    assert state_snapshot is not None

    detail = reconstruct_memory_detail(
        state_snapshot["memory_id"],
        snapshot_lookup=runtime.memory.snapshot_by_id,
        successor_lookup=runtime.memory.successor_links,
    )
    assert detail["found"]
    assert detail["item_count"] >= 1024
    assert detail["energy_summary"]["positive_real_count"] >= 1024

    bn = trace["fast_system"]["bn"]
    if bn:
        bn_detail = reconstruct_bn_row_detail(
            bn[0],
            snapshot_lookup=runtime.memory.snapshot_by_id,
            successor_lookup=runtime.memory.successor_links,
        )
        assert bn_detail["found"]
        assert "score_breakdown" in bn_detail

    observatory = reconstruct_tick_observatory(
        trace,
        snapshot_lookup=runtime.memory.snapshot_by_id,
        successor_lookup=runtime.memory.successor_links,
    )
    assert observatory["schema_id"] == "apv21_observatory_reconstruction/v1"
    assert observatory["state_pool"]["energy_summary"]["positive_real_count"] > 0
    assert "fast_system" in observatory
    assert "slow_system" in observatory
    assert "inner_world" in observatory
    assert "action" in observatory


def test_slow_system_query_uses_focus_continuation_buffer() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("alpha beta gamma")
    runtime.process_text_tick("")
    trace = runtime.process_text_tick("")
    slow_query = trace["slow_system"]["query"]
    assert slow_query
    assert any(str(item.get("source_type", "")) == "focus_continuation" or float(item.get("query_weight", 0.0) or 0.0) > 0.0 for item in slow_query)


def test_focus_buffer_episode_replay_is_bounded_and_weighted() -> None:
    from memory.short_term.focus_buffer import FocusBuffer

    buffer = FocusBuffer(focus_history_limit=8, max_replay_items=2, episode_break_overlap=0.25)
    buffer.push(
        [
            {"sa_label": "text::alpha", "focus_score": 1.0, "real_energy": 1.0},
            {"sa_label": "text::beta", "focus_score": 0.8, "real_energy": 0.8},
        ],
        tick_index=0,
    )
    buffer.push(
        [
            {"sa_label": "text::gamma", "focus_score": 1.0, "real_energy": 1.0},
            {"sa_label": "text::delta", "focus_score": 0.7, "real_energy": 0.7},
        ],
        tick_index=1,
    )

    trace = buffer.trace(tick_index=2)
    assert trace["schema_id"] == "focus_continuation_trace/v1"
    assert trace["active_episode_id"] >= 1
    assert trace["replay_candidates"]
    assert len(trace["replay_candidates"][0]["labels"]) <= 2

    replay_rows = buffer.build_replay_query_items([], tick_index=2)
    assert replay_rows
    assert len(replay_rows) <= 2
    assert all(row["source_type"] == "focus_replay" for row in replay_rows)
    assert all(float(row.get("query_weight", 0.0) or 0.0) > 0.0 for row in replay_rows)


def test_runtime_slow_system_exposes_focus_replay_without_mixing_memory_kind() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("alpha beta gamma", trace_mode="debug")
    runtime.process_text_tick("delta epsilon zeta", trace_mode="debug")
    trace = runtime.process_text_tick("", trace_mode="debug")

    continuation = trace["slow_system"]["focus_continuation"]
    assert continuation["schema_id"] == "focus_continuation_trace/v1"
    assert continuation["replay_candidates"]

    slow_query = trace["slow_system"]["query"]
    assert any("focus_replay" in (item.get("query_sources", []) or []) for item in slow_query)
    assert all(row["memory_kind"] == "focus" for row in trace["slow_system"]["bn_prime"])


def test_observatory_reconstruction_exposes_focus_continuation_trace() -> None:
    from observatory import reconstruct_tick_observatory

    runtime = APV21Runtime()
    runtime.process_text_tick("alpha beta gamma")
    runtime.process_text_tick("delta epsilon zeta")
    trace = runtime.process_text_tick("")
    reconstructed = reconstruct_tick_observatory(
        trace,
        snapshot_lookup=runtime.memory.snapshot_by_id,
        successor_lookup=runtime.memory.successor_links,
    )
    assert reconstructed["slow_system"]["focus_continuation"]["schema_id"] == "focus_continuation_trace/v1"
    assert reconstructed["focus"]["continuation"]["schema_id"] == "focus_continuation_trace/v1"


def test_attention_selector_keeps_continuation_bonus_in_trace() -> None:
    runtime = APV21Runtime()
    first = runtime.process_text_tick("red blue green")
    second = runtime.process_text_tick("")
    first_focus = set(first["attention"]["selected_labels"])
    ranked_second = second["attention"]["ranked_items"]
    assert ranked_second
    continuation_rows = [row for row in ranked_second if str(row.get("sa_label", "") or "") in first_focus]
    assert continuation_rows
    assert any(float(row.get("continuation_bonus", 0.0) or 0.0) >= 0.0 for row in continuation_rows)


def test_focus_successor_bias_learns_unique_text_continuation() -> None:
    runtime = APV21Runtime()
    for _ in range(4):
        runtime.process_text_tick("hello")
        runtime.process_text_tick("world")

    runtime.process_text_tick("hello")
    trace = runtime.process_text_tick("")
    successor_bias = trace["slow_system"]["successor_bias"]
    assert successor_bias["schema_id"] == "focus_successor_bias/v1"
    assert successor_bias["items"]
    assert any(row["sa_label"] == "text::world" and float(row["bias"]) > 0.0 for row in successor_bias["items"])
    ranked = trace["attention"]["ranked_items"]
    world_rows = [row for row in ranked if row.get("sa_label") == "text::world"]
    assert world_rows
    assert float(world_rows[0].get("successor_bias", 0.0) or 0.0) > 0.0


def test_focus_successor_bias_branch_entropy_weakens_ambiguous_context() -> None:
    from memory.short_term.focus_successor_bias import FocusSuccessorBias

    unique = FocusSuccessorBias(gain=0.42, max_bias=0.48)
    for tick in range(5):
        unique.observe_transition(
            previous_focus_labels=["text::cue"],
            current_focus_items=[{"sa_label": "text::answer", "real_energy": 1.0}],
            tick_index=tick,
        )
    unique_trace = unique.build_bias(
        previous_focus_labels=["text::cue"],
        candidate_items=[{"sa_label": "text::answer"}],
        tick_index=10,
    )
    unique_bias = max(float(row.get("bias", 0.0) or 0.0) for row in unique_trace["items"])

    ambiguous = FocusSuccessorBias(gain=0.42, max_bias=0.48)
    words = ["red", "blue", "green", "yellow", "purple"]
    for tick, word in enumerate(words):
        ambiguous.observe_transition(
            previous_focus_labels=["text::cue"],
            current_focus_items=[{"sa_label": f"text::{word}", "real_energy": 1.0}],
            tick_index=tick,
        )
    ambiguous_trace = ambiguous.build_bias(
        previous_focus_labels=["text::cue"],
        candidate_items=[{"sa_label": f"text::{word}"} for word in words],
        tick_index=10,
    )
    ambiguous_items = ambiguous_trace["items"]
    ambiguous_bias = max(float(row.get("bias", 0.0) or 0.0) for row in ambiguous_items)
    assert unique_bias > ambiguous_bias


def test_focus_successor_bias_does_not_override_strong_real_stimulus() -> None:
    from core.attention.selector import AttentionSelector

    selector = AttentionSelector(
        focus_limit=1,
        pressure_gain=0.6,
        attention_gain_weight=0.8,
        fatigue_weight=0.5,
        continuation_bias=0.0,
    )
    trace = selector.select(
        [
            {"sa_label": "text::world", "real_energy": 0.2, "cognitive_pressure": 0.1, "attention_gain": 0.0, "virtual_energy": 0.1},
            {"sa_label": "text::danger", "real_energy": 2.0, "cognitive_pressure": 2.0, "attention_gain": 1.2, "virtual_energy": 0.0},
        ],
        successor_bias={"bias_by_label": {"text::world": 0.48}},
    )
    assert trace["selected_labels"] == ["text::danger"]
    world = next(row for row in trace["ranked_items"] if row["sa_label"] == "text::world") if len(trace["ranked_items"]) > 1 else None
    assert world is not None
    assert float(world.get("successor_bias", 0.0) or 0.0) > 0.0


def test_cognitive_feelings_enter_trace_and_state_pool() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("apple is fruit")
    trace = runtime.process_text_tick("apple is fruit")
    feelings = trace["cognitive_feelings"]
    assert feelings["channels"]
    assert feelings["items"]
    snapshot = trace["state_pool"]["snapshot"]["items"]
    feeling_labels = {str(item.get("sa_label", "") or "") for item in feelings["items"]}
    assert any(str(item.get("sa_label", "") or "") in feeling_labels for item in snapshot)


def test_runtime_load_feeling_enters_trace_state_pool_and_tuner() -> None:
    from config.defaults import ObservabilityConfig, RuntimeConfig, RuntimeLoadFeelingConfig

    runtime = APV21Runtime(
        config=RuntimeConfig(
            observability=ObservabilityConfig(target_tick_ms=1.0),
            runtime_load_feeling=RuntimeLoadFeelingConfig(
                min_activation=0.01,
                state_item_soft_limit=1,
                r_state_item_soft_limit=1,
                attention_candidate_soft_limit=1,
                pending_index_soft_limit=1,
            ),
        )
    )
    trace = runtime.process_text_tick("alpha beta gamma")
    load = trace["runtime_load_feeling"]

    assert load["schema_id"] == "runtime_load_feeling/v1"
    assert load["policy"] == "trace_first_no_runtime_budget_mutation"
    assert load["suggested_modulation"]["applied"] is False
    assert "complexity" in load["channels"]
    assert "simplicity" in load["channels"]
    assert load["items"]

    snapshot_labels = [item["sa_label"] for item in trace["state_pool"]["snapshot"]["items"]]
    assert any(label in {"feeling::complexity", "feeling::simplicity"} for label in snapshot_labels)
    assert "runtime_load_coupling" in trace["cognitive_feelings"]

    tuner_metrics = trace["tuner"]["metrics"]
    assert "runtime_load_ratio" in tuner_metrics
    assert "runtime_complexity" in tuner_metrics


def test_runtime_budget_controller_applies_next_tick_nonsemantic_budget() -> None:
    from config.defaults import (
        MemoryConfig,
        ObservabilityConfig,
        RuntimeBudgetControllerConfig,
        RuntimeConfig,
        RuntimeLoadFeelingConfig,
        StatePoolConfig,
        TextSensorConfig,
    )

    config = RuntimeConfig(
        observability=ObservabilityConfig(target_tick_ms=1.0, trace_item_preview_limit=20, trace_r_state_item_preview_limit=6),
        text_sensor=TextSensorConfig(budget_limit=256, competition_limit=256),
        state_pool=StatePoolConfig(r_state_items_per_head=64, r_state_head_limit=5, memory_snapshot_limit=256),
        memory=MemoryConfig(index_jobs_per_tick=1, index_maintenance_min_remaining_ms=0.0, index_maintenance_max_ms=10.0),
        runtime_load_feeling=RuntimeLoadFeelingConfig(
            min_activation=0.01,
            state_item_soft_limit=1,
            r_state_item_soft_limit=1,
            attention_candidate_soft_limit=1,
            pending_index_soft_limit=1,
        ),
        runtime_budget_controller=RuntimeBudgetControllerConfig(
            smoothing_alpha=1.0,
            readout_min_multiplier=0.72,
            min_r_state_items_per_head=8,
        ),
    )
    runtime = APV21Runtime(config=config)
    first = runtime.process_text_tick(" ".join(f"load{i}" for i in range(180)))
    second = runtime.process_text_tick(" ".join(f"load{i}" for i in range(180)))

    first_budget = first["runtime_budget_controller"]
    second_budget = second["runtime_budget_controller"]

    assert first_budget["applied"] is False
    assert second_budget["applied"] is True
    assert second_budget["source_tick_index"] == first["tick_index"]
    assert second_budget["readout_budget"]["items_per_head"] < config.state_pool.r_state_items_per_head
    assert second["state_pool"]["r_state"]["items_per_head"] == second_budget["readout_budget"]["items_per_head"]
    assert second["learning"]["index_maintenance"]["runtime_budget"]["jobs_per_tick"] <= config.memory.index_jobs_per_tick
    assert second["runtime_budget_controller"]["trace_budget"]["item_preview_limit"] <= config.observability.trace_item_preview_limit
    assert second_budget["semantic_mutation"] == {
        "real_decay": False,
        "virtual_decay": False,
        "prune_threshold": False,
    }
    assert runtime.state_pool.real_decay == config.state_pool.real_decay
    assert runtime.state_pool.virtual_decay == config.state_pool.virtual_decay
    assert runtime.state_pool.prune_threshold == config.state_pool.prune_threshold


def test_cognitive_feeling_items_have_explanatory_anchor_meta() -> None:
    runtime = APV21Runtime()
    trace = runtime.process_text_tick("today weather nice")
    items = trace["cognitive_feelings"]["items"]
    if not items:
        trace = runtime.process_text_tick("today weather nice")
        items = trace["cognitive_feelings"]["items"]
    assert items
    assert all(isinstance(item.get("anchor_meta"), dict) for item in items)


def test_online_embedding_summary_is_exposed_and_updates() -> None:
    runtime = APV21Runtime()
    runtime.process_text_tick("apple fruit sweet")
    trace = runtime.process_text_tick("apple fruit sweet")
    summary = trace["learning"]["online_embedding"]
    assert summary["token_count"] > 0
    assert summary["token_limit"] >= summary["token_count"]


def test_online_embedding_negative_evidence_lowers_similarity() -> None:
    from memory.embedding.online_store import OnlineEmbeddingStore

    store = OnlineEmbeddingStore(dim=16, token_limit=64, min_support_to_promote=1, per_tick_update_limit=16)
    store.begin_tick(0)
    store.observe_positive_pair("text::apple", "vision_obj::round", weight=1.0)
    positive = store.learned_similarity(["text::apple"], ["vision_obj::round"])
    assert positive["score"] > 0.0
    assert positive["contributions"]

    store.begin_tick(1)
    store.observe_negative_pair("text::apple", "vision_obj::round", weight=3.0)
    corrected = store.learned_similarity(["text::apple"], ["vision_obj::round"])
    assert corrected["score"] < positive["score"]
    assert corrected["negative_contributions"]


def test_online_embedding_directed_anchor_updates_only_source_token() -> None:
    from memory.embedding.online_store import OnlineEmbeddingStore

    store = OnlineEmbeddingStore(dim=16, token_limit=64, min_support_to_promote=1, per_tick_update_limit=16)
    store.begin_tick(0)
    store.observe_positive_anchor("text::pressure_subject", "text::stable_anchor", weight=1.0)
    forward = store.learned_similarity(["text::pressure_subject"], ["text::stable_anchor"])
    reverse = store.learned_similarity(["text::stable_anchor"], ["text::pressure_subject"])
    assert forward["score"] > 0.0
    assert reverse["score"] == 0.0
    assert not reverse["contributions"]

    store.begin_tick(1)
    store.observe_negative_anchor("text::missed_prediction", "text::actual_anchor", weight=1.0)
    forward_negative = store.learned_similarity(["text::missed_prediction"], ["text::actual_anchor"])
    reverse_negative = store.learned_similarity(["text::actual_anchor"], ["text::missed_prediction"])
    assert forward_negative["score"] < 0.0
    assert reverse_negative["score"] == 0.0
    assert not reverse_negative["negative_contributions"]


def test_directed_pressure_update_does_not_move_normal_anchor_relations() -> None:
    from memory.embedding.online_store import OnlineEmbeddingStore

    store = OnlineEmbeddingStore(dim=16, token_limit=64, min_support_to_promote=1, per_tick_update_limit=16)
    store.begin_tick(0)
    store.observe_positive_pair("text::normal_a", "text::normal_b", weight=1.0)
    before_ab = store.learned_similarity(["text::normal_a"], ["text::normal_b"])
    before_ba = store.learned_similarity(["text::normal_b"], ["text::normal_a"])

    store.begin_tick(1)
    store.observe_negative_anchor("text::abnormal_subject", "text::normal_a", weight=3.0)
    after_ab = store.learned_similarity(["text::normal_a"], ["text::normal_b"])
    after_ba = store.learned_similarity(["text::normal_b"], ["text::normal_a"])
    abnormal_to_anchor = store.learned_similarity(["text::abnormal_subject"], ["text::normal_a"])
    anchor_to_abnormal = store.learned_similarity(["text::normal_a"], ["text::abnormal_subject"])

    assert after_ab["score"] == before_ab["score"]
    assert after_ba["score"] == before_ba["score"]
    assert abnormal_to_anchor["score"] < 0.0
    assert anchor_to_abnormal["score"] == 0.0


def test_directed_multi_anchor_updates_preserve_requested_negative_ratio() -> None:
    from memory.embedding.online_store import OnlineEmbeddingStore

    store = OnlineEmbeddingStore(dim=16, token_limit=64, min_support_to_promote=1, per_tick_update_limit=16)
    store.begin_tick(0)
    store.observe_positive_pair("text::normal_a", "text::normal_b", weight=1.0)
    before_anchor_relation = store.learned_similarity(["text::normal_a"], ["text::normal_b"])

    store.begin_tick(1)
    store.observe_negative_anchor("text::abnormal_subject", "text::normal_a", weight=2.0)
    store.observe_negative_anchor("text::abnormal_subject", "text::normal_b", weight=1.0)
    away_a = store.learned_similarity(["text::abnormal_subject"], ["text::normal_a"])
    away_b = store.learned_similarity(["text::abnormal_subject"], ["text::normal_b"])
    after_anchor_relation = store.learned_similarity(["text::normal_a"], ["text::normal_b"])

    assert away_a["score"] < away_b["score"] < 0.0
    ratio = abs(float(away_a["score"])) / abs(float(away_b["score"]))
    assert 1.95 <= ratio <= 2.05
    assert after_anchor_relation["score"] == before_anchor_relation["score"]
    assert store.learned_similarity(["text::normal_a"], ["text::abnormal_subject"])["score"] == 0.0
    assert store.learned_similarity(["text::normal_b"], ["text::abnormal_subject"])["score"] == 0.0


def test_energy_pressure_learning_records_positive_and_negative_events() -> None:
    from memory.store import MemoryStore

    memory = MemoryStore(
        recall_top_k=3,
        predict_top_k=2,
        prediction_energy_scale=0.5,
        max_snapshots_per_kind=16,
        candidate_limit=8,
        scoring_candidate_limit=8,
        online_min_support_to_promote=1,
        online_per_tick_update_limit=32,
    )
    items = [
        {
            "sa_label": "text::unexpected_apple",
            "display_text": "unexpected apple",
            "source_type": "external_text",
            "family": "text",
            "real_energy": 1.2,
            "virtual_energy": 0.2,
            "cognitive_pressure": 1.0,
        },
        {
            "sa_label": "text::actual_context",
            "display_text": "actual context",
            "source_type": "external_text",
            "family": "text",
            "real_energy": 1.1,
            "virtual_energy": 0.1,
            "cognitive_pressure": 0.0,
        },
        {
            "sa_label": "text::missed_prediction",
            "display_text": "missed prediction",
            "source_type": "external_text",
            "family": "text",
            "real_energy": 0.0,
            "virtual_energy": 1.4,
            "cognitive_pressure": -1.4,
        },
    ]
    memory.write_snapshot(tick_index=0, memory_kind="state", items=items, focus_labels=[], source_text="")
    memory.process_idle_index_maintenance(budget=4, max_ms=50.0)

    summary = memory.online_embedding_summary()
    energy = summary["energy_learning"]
    assert energy["schema_id"] == "energy_pressure_online_learning/v1"
    assert energy["total_events"] > 0
    structured = summary["structured_learning_events"]
    assert structured["schema_id"] == "apv21_learning_event_summary/v1"
    assert structured["total_by_type"]["prediction_error_positive"] > 0
    assert structured["total_by_type"]["prediction_error_negative"] > 0
    assert structured["total_by_layer"]["content_recognition_embedding"] > 0
    assert all(row["schema_id"] == "apv21_learning_event/v1" for row in structured["last_events"])
    relations = {event["relation"] for event in energy["last_events"]}
    assert "positive" in relations
    assert "negative" in relations

    negative_score = memory._online.learned_similarity(["text::missed_prediction"], ["text::actual_context"])
    assert negative_score["score"] < 0.0
    assert negative_score["negative_contributions"]
    reverse_negative_score = memory._online.learned_similarity(["text::actual_context"], ["text::missed_prediction"])
    assert reverse_negative_score["score"] == 0.0
    assert not reverse_negative_score["negative_contributions"]


def test_energy_learning_does_not_treat_action_feedback_as_concept_teaching() -> None:
    from memory.store import MemoryStore

    memory = MemoryStore(
        recall_top_k=3,
        predict_top_k=2,
        prediction_energy_scale=0.5,
        max_snapshots_per_kind=16,
        candidate_limit=8,
        scoring_candidate_limit=8,
        online_min_support_to_promote=1,
        online_per_tick_update_limit=32,
    )
    items = [
        {
            "sa_label": "text::context",
            "display_text": "context",
            "source_type": "external_text",
            "family": "text",
            "real_energy": 1.0,
            "virtual_energy": 0.1,
            "cognitive_pressure": 0.9,
        },
        {
            "sa_label": "action_feedback::reward_probe",
            "display_text": "reward probe",
            "source_type": "action_feedback",
            "family": "action_feedback",
            "real_energy": 2.0,
            "virtual_energy": 0.0,
            "cognitive_pressure": 2.0,
            "anchor_meta": {"feedback": {"reward": 1.0, "punishment": 0.0}},
        },
    ]
    memory.write_snapshot(tick_index=0, memory_kind="state", items=items, focus_labels=[], source_text="")
    memory.process_idle_index_maintenance(budget=4, max_ms=50.0)

    energy = memory.online_embedding_summary()["energy_learning"]
    assert all("action_feedback::" not in event["source"] for event in energy["last_events"])
    assert all("action_feedback::" not in event["target"] for event in energy["last_events"])


def test_energy_learning_weights_each_sa_by_its_own_real_energy() -> None:
    from memory.store import MemoryStore

    memory = MemoryStore(
        recall_top_k=3,
        predict_top_k=2,
        prediction_energy_scale=0.5,
        max_snapshots_per_kind=16,
        candidate_limit=8,
        scoring_candidate_limit=8,
        online_min_support_to_promote=1,
        online_per_tick_update_limit=32,
    )
    items = [
        {
            "sa_label": "text::unexpected_subject",
            "display_text": "unexpected subject",
            "source_type": "external_text",
            "family": "text",
            "real_energy": 1.2,
            "virtual_energy": 0.1,
            "cognitive_pressure": 1.1,
        },
        {
            "sa_label": "text::strong_context",
            "display_text": "strong context",
            "source_type": "external_text",
            "family": "text",
            "real_energy": 1.4,
            "virtual_energy": 0.1,
            "cognitive_pressure": 0.0,
        },
        {
            "sa_label": "text::weak_context",
            "display_text": "weak context",
            "source_type": "external_text",
            "family": "text",
            "real_energy": 0.12,
            "virtual_energy": 0.01,
            "cognitive_pressure": 0.0,
        },
    ]
    memory.write_snapshot(tick_index=0, memory_kind="state", items=items, focus_labels=[], source_text="")
    memory.process_idle_index_maintenance(budget=4, max_ms=50.0)

    events = memory.online_embedding_summary()["energy_learning"]["last_events"]
    subject_events = [
        event
        for event in events
        if event["relation"] == "positive" and event["source"] == "text::unexpected_subject"
    ]
    weights = {event["target"]: float(event["weight"]) for event in subject_events}
    assert weights["text::strong_context"] > weights["text::weak_context"]
    strong = next(event for event in subject_events if event["target"] == "text::strong_context")
    weak = next(event for event in subject_events if event["target"] == "text::weak_context")
    assert strong["evidence"]["target_real_signal"] > weak["evidence"]["target_real_signal"]
    assert strong["evidence"]["source_real_signal"] > 0.0
    reverse = memory._online.learned_similarity(["text::strong_context"], ["text::unexpected_subject"])
    assert reverse["score"] == 0.0


