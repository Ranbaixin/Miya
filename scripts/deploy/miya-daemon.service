[Unit]
Description=MIYA Daemon (AI virtual persona, QQ bot backend)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/miya
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUTF8=1
ExecStart=/usr/local/bin/uv run python -X utf8 run/daemon.py --api-host 127.0.0.1 --api-port 9800
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60
KillMode=mixed

[Install]
WantedBy=multi-user.target
