# ========================================
# 弥娅 MIYA - 配置文件
# ========================================
# 修改此文件中的实际值
# 注意：不要将此文件提交到公开仓库！

# ========================================
# 应用基础配置
# ========================================
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/miya.log

# ========================================
# AI大模型配置
# ========================================
# 推荐优先使用硅基流动（免费额度充足）

# 通用AI参数
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_REQUEST_MAX_RETRIES=2
AI_REQUEST_TIMEOUT=30
AI_PROVIDER=siliconflow

# --- 硅基流动（推荐，首选） ---
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY_HERE
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_QWEN_7B_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_QWEN_72B_MODEL=Qwen/Qwen2.5-72B-Instruct
SILICONFLOW_KIMI_K2_MODEL=Pro/moonshotai/Kimi-K2.6
SILICONFLOW_DEEPSEEK_R1_DISTILL_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
SILICONFLOW_GLM_4_MODEL=THUDM/glm-4-9b-chat

# --- DeepSeek 官方 ---
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_V3_MODEL=deepseek-v4-flash
DEEPSEEK_R1_MODEL=deepseek-v4-flash

# --- 智谱AI ---
ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY_HERE
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_GLM_4_MODEL=glm-4
ZHIPU_GLM_4_PLUS_MODEL=glm-4-plus
ZHIPU_GLM_4V_MODEL=glm-4v
ZHIPU_GLM_46V_FLASH_MODEL=glm-4.6v-flash

# --- 阿里云通义千问 ---
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_QWEN_VL_MODEL=qwen-vl-plus

# --- Tavily AI 搜索（专为 AI 设计的搜索引擎） ---
# 注册地址: https://tavily.com/
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# ========================================
# Grok AI 配置
# ========================================
GROK_API_KEY=YOUR_GROK_API_KEY
GROK_MODEL=grok-2-1212

# ========================================
# AI绘画引擎 API Keys
# ========================================
# OpenAI DALL·E
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# NovelAI Diffusion (动漫风)
NOVELAI_API_KEY=YOUR_NOVELAI_API_KEY
# Stable Diffusion WebUI (本地，不用 API key)
# SD_WEBUI_URL=http://127.0.0.1:7860
# ComfyUI (本地)
# COMFYUI_URL=http://127.0.0.1:8188

# ========================================
# QQ机器人配置
# ========================================
QQ_ONEBOT_WS_URL=ws://localhost:3001
QQ_ONEBOT_TOKEN=
QQ_BOT_QQ=YOUR_QQ_BOT_QQ
QQ_SUPERADMIN_QQ=YOUR_QQ_NUMBER
QQ_RECONNECT_INTERVAL=5.0
QQ_PING_INTERVAL=20
QQ_MAX_MESSAGE_SIZE=104857600
QQ_OCR_ENABLED=true
QQ_ACTIVE_CHAT_ENABLED=true

# ========================================
# 人格配置
# ========================================
PERSONALITY_WARMTH=0.5
PERSONALITY_LOGIC=0.7
PERSONALITY_CREATIVITY=0.8
PERSONALITY_EMPATHY=0.6
PERSONALITY_RESILIENCE=0.7

# ========================================
# 情绪配置
# ========================================
EMOTION_DECAY_RATE=0.1

# ========================================
# 记忆配置
# ========================================
MEMORY_TIDE_TTL=3600
MEMORY_SHORT_TERM_CAPACITY=20

# ========================================
# Runtime API配置
# ========================================
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
WEB_API_CORS_ORIGINS=*

# ========================================
# 性能配置
# ========================================
MIYA_FORCE_CPU=true

# ========================================
# 安全配置
# ========================================
INJECTION_DETECTION_ENABLED=true

# ========================================
# LifeBook配置
# ========================================
LIFEBOOK_ENABLED=true
LIFEBOOK_BASE_DIR=data/lifebook
LIFEBOOK_DEFAULT_MONTHS_BACK=1

# ========================================
# 对话上下文配置
# ========================================
CONVERSATION_CONTEXT_MAX_COUNT=5
CONVERSATION_CONTEXT_MAX_TOKENS=1000

# ========================================
# GitHub配置
# ========================================
GITHUB_REPO_OWNER=YOUR_GITHUB_REPO_OWNER
GITHUB_REPO_NAME=YOUR_GITHUB_REPO_NAME
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
GITHUB_BRANCH=main

# ========================================
# PaddleOCR配置
# ========================================
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Lark/飞书
LARK_APP_ID=YOUR_LARK_APP_ID
LARK_APP_SECRET=YOUR_LARK_APP_SECRET

# ========================================
# 多平台配置 (v7.0)
# ========================================
# QQ 官方机器人
QQ_APPID=YOUR_QQ_APPID
QQ_SECRET=YOUR_QQ_SECRET
QQ_BOT_QQ=YOUR_QQ_BOT_QQ
# Telegram
TELEGRAM_BOT_TOKEN=
# Discord
DISCORD_BOT_TOKEN=
# 飞书
LARK_APP_ID=YOUR_LARK_APP_ID
LARK_APP_SECRET=YOUR_LARK_APP_SECRET
# KOOK
KOOK_TOKEN=
# Slack
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
# 钉钉
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# LINE
LINE_CHANNEL_SECRET=
# Satori
SATORI_WS_URL=ws://127.0.0.1:5500
# OneBot/NapCat
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_BOT_QQ=YOUR_BOT_QQ_NUMBER
# 企业微信
WECOM_CORP_ID=
WECOM_SECRET=
# 微信公众号
WEIXIN_APP_ID=
WEIXIN_APP_SECRET=
