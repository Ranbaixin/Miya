# ========================================
# 弥娅 MIYA - 配置文件
# ========================================
# 修改此文件中的实际值
# 注意：不要将此文件提交到公开仓库！

# ========================================
# 应用基础配置
# ========================================
DEBUG=false
LOG_LEVEL=INFO

# ========================================
# AI大模型配置
# ========================================
# 推荐优先使用硅基流动（免费额度充足）

# 通用AI参数
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_REQUEST_MAX_RETRIES=2
AI_REQUEST_TIMEOUT=30
AI_PROVIDER=siliconflow

# --- 硅基流动（推荐，首选） ---
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY_HERE
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# --- DeepSeek 官方 ---
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# --- 智谱AI ---
ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY_HERE
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# --- 阿里云通义千问 ---
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Tavily AI 搜索（专为 AI 设计的搜索引擎） ---
# 注册地址: https://tavily.com/
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# ========================================
# Grok AI 配置
# ========================================
GROK_API_KEY=YOUR_GROK_API_KEY
GROK_MODEL=grok-2-1212

# ========================================
# QQ机器人配置
# ========================================
QQ_ONEBOT_WS_URL=ws://localhost:3001
QQ_ONEBOT_TOKEN=
QQ_BOT_QQ=YOUR_QQ_BOT_QQ
QQ_SUPERADMIN_QQ=YOUR_QQ_NUMBER

# ========================================
# Redis配置
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ========================================
# Milvus配置
# ========================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=miya_memory

# ========================================
# Neo4j配置（可选，默认不启用）
# 2026-09：知识图谱默认存 SQLite（miya_memory.db 的 kg_* 表，零部署负担）。
# 仅在显式设置 MIYA_USE_NEO4J=1 时才启用 Neo4j 双写（还需下方密码）。
# ========================================
# MIYA_USE_NEO4J=1
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# ========================================
# 人格配置
# ========================================
PERSONALITY_WARMTH=0.5
PERSONALITY_LOGIC=0.7
PERSONALITY_CREATIVITY=0.8
PERSONALITY_EMPATHY=0.6
PERSONALITY_RESILIENCE=0.7

# ========================================
# 情绪配置
# ========================================
EMOTION_DECAY_RATE=0.1

# ========================================
# 记忆配置
# ========================================
MEMORY_TIDE_TTL=3600

# ========================================
# Runtime API配置
# ========================================

# ========================================
# 性能配置
# ========================================
MIYA_FORCE_CPU=true

# ========================================
# 安全配置
# ========================================

# ========================================
# LifeBook配置
# ========================================
LIFEBOOK_ENABLED=true
LIFEBOOK_BASE_DIR=data/lifebook
LIFEBOOK_DEFAULT_MONTHS_BACK=1

# ========================================
# 对话上下文配置
# ========================================
CONVERSATION_CONTEXT_MAX_COUNT=5
CONVERSATION_CONTEXT_MAX_TOKENS=1000

# ========================================
# GitHub配置
# ========================================

# ========================================
# PaddleOCR配置
# ========================================
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Lark/飞书
LARK_APP_ID=YOUR_LARK_APP_ID
LARK_APP_SECRET=YOUR_LARK_APP_SECRET

# ========================================
# 多平台配置 (v7.0)
# ========================================
# QQ 官方机器人
QQ_APPID=YOUR_QQ_APPID
QQ_SECRET=YOUR_QQ_SECRET
# Telegram
TELEGRAM_BOT_TOKEN=
# Discord
DISCORD_BOT_TOKEN=
# 飞书
# KOOK
# Slack
# 钉钉
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# LINE
# Satori
# OneBot/NapCat
# 企业微信
# 微信公众号

# ==================== 安全与访问控制（2026-09 新增声明） ====================
# 注意：以下键此前未声明，导致部署者大概率遗漏安全配置。此处仅声明键名与用途。
# MIYA_API_TOKEN        管理 API(9800) 远程访问令牌；未设置时管理 API 仅允许本机访问
# MIYA_JWT_SECRET       Web API 登录态 JWT 密钥（首次登录自动生成并写入 config/.env）
# MIYA_ADMIN_USERNAME   管理员用户名（默认 admin）
# MIYA_ADMIN_PASSWORD_HASH  管理员口令 scrypt 哈希（首次启动自动生成）
# MIYA_ENCRYPTION_KEY   敏感配置加密密钥
# MIYA_API_HOST         管理 API 监听地址（默认 0.0.0.0；建议本机使用时改为 127.0.0.1）
# MIYA_API_PORT         管理 API 端口（默认 9800）
# MIYA_CORS_ORIGINS     Web API CORS 白名单（逗号分隔）
# MIYA_ENV              运行环境标识
